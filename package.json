{
  "name": "tech-shop",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node scripts/migrate.mjs && npm run build --workspace frontend",
    "build:frontend": "npm run build --workspace frontend",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "start": "node backend/server.js",
    "dev": "concurrently \"node --env-file=.env.local --watch backend/server.js\" \"npm run dev --workspace frontend\"",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/blob": "^2.8.1",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "sharp": "^0.35.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.9.10"
  },
  "author": "Emre Karayaman",
  "license": "MIT"
}
